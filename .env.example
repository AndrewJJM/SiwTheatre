# Copia questo file in ".env" e compila i valori reali.
# Il file .env e' nel .gitignore e NON va mai committato.

# --- Database (usati da docker-compose per Postgres e per l'app) ---
POSTGRES_DB=siwTheatre
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- OAuth2 (opzionali: senza valori reali il login social non funziona,
#     ma la registrazione e il login con form restano disponibili) ---
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
FACEBOOK_CLIENT_ID=changeme
FACEBOOK_CLIENT_SECRET=changeme
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
